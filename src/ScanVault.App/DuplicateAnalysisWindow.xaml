<Window x:Class="ScanVault.App.DuplicateAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Detection" Width="1120" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Run duplicate analysis" Command="{Binding RunCommand}" Padding="12,6" Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,6" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Duplicate Detection" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <UniformGrid Columns="6">
                <StackPanel>
                    <TextBlock Text="Exact groups" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding Summary.ExactDuplicateGroups}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Conflicting ID" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding Summary.ConflictingIdGroups}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Probable" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding Summary.ProbableDuplicateGroups}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Partial" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding Summary.PartialDuplicateGroups}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Assets involved" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding Summary.AssetsInvolved}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Reclaimable estimate" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding PotentialReclaimableSize}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </UniformGrid>
            <TextBlock Grid.Column="1" Text="{Binding StaleText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="18,0,0,0" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="FILTERS:" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox Content="Exact" IsChecked="{Binding ShowExact}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}" />
                <CheckBox Content="Conflicting ID" IsChecked="{Binding ShowConflictingId}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}" />
                <CheckBox Content="Probable" IsChecked="{Binding ShowProbable}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}" />
                <CheckBox Content="Partial" IsChecked="{Binding ShowPartial}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}" />
                <CheckBox Content="Has Issues" IsChecked="{Binding ShowHasIssues}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}" />
                <TextBlock Text="Confidence" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,6,0" />
                <ComboBox Width="140" ItemsSource="{Binding ConfidenceOptions}" SelectedItem="{Binding MinimumConfidence}" />
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Background="White" Foreground="{StaticResource TextDarkPrimary}"
                      RowBackground="White" AlternatingRowBackground="#F4F6F8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Group ID" Binding="{Binding GroupId}" Width="140" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="170" />
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="110" />
                    <DataGridTextColumn Header="Asset count" Binding="{Binding AssetCount}" Width="90" />
                    <DataGridTextColumn Header="Estimated duplicate size" Binding="{Binding EstimatedDuplicateSize}" Width="160" />
                    <DataGridTextColumn Header="Reasons" Binding="{Binding ReasonDisplay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="#343B46" />

            <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedGroup.Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Background="White" Foreground="{StaticResource TextDarkPrimary}"
                      RowBackground="White" AlternatingRowBackground="#F4F6F8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Asset name" Binding="{Binding AssetName}" Width="220" />
                    <DataGridTextColumn Header="Asset ID" Binding="{Binding AssetId}" Width="140" />
                    <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="*" />
                    <DataGridTextColumn Header="Completeness" Binding="{Binding Completeness}" Width="135" />
                    <DataGridTextColumn Header="File count" Binding="{Binding FileCount}" Width="80" />
                    <DataGridTextColumn Header="Total size" Binding="{Binding TotalSize}" Width="100" />
                    <DataGridTextColumn Header="Hash status" Binding="{Binding HashStatus}" Width="105" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open asset" Command="{Binding OpenAssetCommand}" Padding="12,5" Margin="0,0,8,0" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Padding="12,5" Margin="0,0,8,0" />
                <Button Content="Compare selected pair" Command="{Binding CompareSelectedPairCommand}" Padding="12,5" Margin="0,0,8,0" />
                <Button Content="Export group" Command="{Binding ExportGroupCommand}" Padding="12,5" Margin="0,0,8,0" />
                <Button Content="Close" IsCancel="True" Padding="12,5" />
            </StackPanel>
            <ProgressBar Width="170" Height="8" IsIndeterminate="True" VerticalAlignment="Center">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </DockPanel>
    </Grid>
</Window>
