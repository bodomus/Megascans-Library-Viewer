<Window x:Class="ScanVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScanVault.App.Controls"
        xmlns:models="clr-namespace:ScanVault.Core.Models;assembly=ScanVault.Core"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClosePreviewCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding OpenComparisonCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="154" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}"
                BorderBrush="#343B46" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Settings" Click="OnSettingsClick" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="About / Diagnostics" Click="OnDiagnosticsClick" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Scan History" Click="OnScanHistoryClick" Padding="14,6" Margin="0,0,8,0" />
                        <Button x:Name="ExportReportButton" Content="Export Report" Click="OnExportReportClick" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Create UE Import Package" Command="{Binding CreateUnrealImportPackageCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Duplicate Detection" Click="OnDuplicateDetectionClick" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Rescan" Command="{Binding RescanCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Cancel" Command="{Binding CancelScanCommand}" Padding="14,6" Margin="0,0,14,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter metadata and content inventory" VerticalContentAlignment="Center" Padding="10,5" MinWidth="220" Margin="0,0,60,0" />
                    <ComboBox Grid.Column="2" Margin="0,0,12,0" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding SortMode, Mode=OneWay}" SelectionChanged="OnSortSelectionChanged" ToolTip="Sort visible assets" />
                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,5,0,0">
                    <TextBlock Text="CONTENT:" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="CHECK ALL" IsChecked="{Binding FilterAll, Mode=OneWay}" Command="{Binding ToggleAllInventoryFiltersCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Has FBX" IsChecked="{Binding FilterHasFbx, Mode=OneWay}" Command="{Binding ToggleHasFbxCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Has LODs" IsChecked="{Binding FilterHasLods, Mode=OneWay}" Command="{Binding ToggleHasLodsCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Billboard" IsChecked="{Binding FilterHasBillboard, Mode=OneWay}" Command="{Binding ToggleHasBillboardCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Atlas" IsChecked="{Binding FilterHasAtlas, Mode=OneWay}" Command="{Binding ToggleHasAtlasCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Complete" IsChecked="{Binding FilterComplete, Mode=OneWay}" Command="{Binding ToggleCompleteCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Incomplete" IsChecked="{Binding FilterIncomplete, Mode=OneWay}" Command="{Binding ToggleIncompleteCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Ambiguous" IsChecked="{Binding FilterAmbiguous, Mode=OneWay}" Command="{Binding ToggleAmbiguousCommand}" Margin="0,0,18,0" Foreground="{StaticResource TextCheckBox}" />
                    <TextBlock Text="UE:" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="Ready" IsChecked="{Binding FilterUnrealReady, Mode=OneWay}" Command="{Binding ToggleUnrealReadyCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Warnings" IsChecked="{Binding FilterUnrealReadyWithWarnings, Mode=OneWay}" Command="{Binding ToggleUnrealReadyWithWarningsCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Not Ready" IsChecked="{Binding FilterUnrealNotReady, Mode=OneWay}" Command="{Binding ToggleUnrealNotReadyCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Unknown" IsChecked="{Binding FilterUnrealUnknown, Mode=OneWay}" Command="{Binding ToggleUnrealUnknownCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="N/A" IsChecked="{Binding FilterUnrealNotApplicable, Mode=OneWay}" Command="{Binding ToggleUnrealNotApplicableCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Missing Mesh" IsChecked="{Binding FilterUnrealMissingMesh, Mode=OneWay}" Command="{Binding ToggleUnrealMissingMeshCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Missing Normal" IsChecked="{Binding FilterUnrealMissingNormal, Mode=OneWay}" Command="{Binding ToggleUnrealMissingNormalCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Missing LODs" IsChecked="{Binding FilterUnrealMissingLods, Mode=OneWay}" Command="{Binding ToggleUnrealMissingLodsCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Blocking" IsChecked="{Binding FilterUnrealBlockingIssues, Mode=OneWay}" Command="{Binding ToggleUnrealBlockingIssuesCommand}" Margin="0,0,12,0" Foreground="{StaticResource TextCheckBox}"/>
                    <CheckBox Content="Warnings" IsChecked="{Binding FilterUnrealWarnings, Mode=OneWay}" Command="{Binding ToggleUnrealWarningsCommand}" Foreground="{StaticResource TextCheckBox}"/>
                </WrapPanel>
                <Border Grid.Row="2" Margin="0,6,0,0" Padding="7,4" Background="#292E37" CornerRadius="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="COMPARE:" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ComparisonLeftName}" Foreground="{StaticResource TextPrimary}" Width="220" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="&lt;-&gt;" Foreground="{StaticResource TextSecondary}" Margin="6,0" />
                            <TextBlock Text="{Binding ComparisonRightName}" Foreground="{StaticResource TextPrimary}" Width="220" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ComparisonStateText, StringFormat=-- {0}}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add selected" Command="{Binding AddSelectedToComparisonCommand}" Padding="10,3" Margin="0,0,6,0" />
                            <Button x:Name="CompareAssetsButton" Content="Compare assets" Command="{Binding OpenComparisonCommand}" Padding="10,3" Margin="0,0,6,0" ToolTip="Ctrl+Shift+C" />
                            <Button Content="Clear" Command="{Binding ClearComparisonCommand}" Padding="10,3" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                    BorderBrush="#343B46" BorderThickness="0,0,1,0" Padding="8">
                                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="6,4,6,6">
                        <TextBlock DockPanel.Dock="Left" Text="SMART COLLECTIONS" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveSmartCollectionStateText}" FontSize="11" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding BuiltInSmartCollections}" SelectedItem="{Binding SelectedSmartCollection, Mode=TwoWay}"
                             MouseDoubleClick="OnSmartCollectionDoubleClick" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" Margin="0,0,0,2" ToolTip="{Binding ToolTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#34485F" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Background" Value="#4B3D2E" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountDisplay}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,6,0,4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,4">
                            <Button Content="Save" Click="OnSaveSmartCollectionClick" Padding="5,2" Margin="0,0,4,0" />
                            <Button Content="Apply" Command="{Binding ApplySmartCollectionCommand}" Padding="5,2" Margin="0,0,4,0" />
                            <Button Content="Edit" Click="OnEditSmartCollectionClick" Padding="5,2" Margin="0,0,4,0" />
                            <Button Content="Del" Click="OnDeleteSmartCollectionClick" Padding="5,2" />
                        </UniformGrid>
                        <UniformGrid Grid.Row="1" Columns="4">
                            <Button Content="Update" Command="{Binding UpdateActiveSmartCollectionCommand}" Padding="5,2" Margin="0,0,4,0" />
                            <Button Content="Copy" Command="{Binding DuplicateSmartCollectionCommand}" Padding="5,2" Margin="0,0,4,0" />
                            <Button Content="Reset" Command="{Binding ResetSmartCollectionCommand}" Padding="5,2" Margin="0,0,4,0" />
                            <Button Content="Manual" Command="{Binding DeactivateSmartCollectionCommand}" Padding="5,2" />
                        </UniformGrid>
                    </Grid>

                    <ListBox Grid.Row="3" ItemsSource="{Binding UserSmartCollections}" SelectedItem="{Binding SelectedSmartCollection, Mode=TwoWay}"
                             MouseDoubleClick="OnSmartCollectionDoubleClick" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" Margin="0,0,0,2" ToolTip="{Binding ToolTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#34485F" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Background" Value="#4B3D2E" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountDisplay}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="#FFB3A7" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="4" Text="PHYSICAL FOLDERS" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="6,8,6,8" />
                    <TreeView Grid.Row="5" ItemsSource="{Binding Folders}" SelectedItemChanged="OnFolderSelected" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#D9DEE5" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FullPath}" />
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#343B46" />

            <ListBox x:Name="AssetList" Grid.Column="2" ItemsSource="{Binding Assets}"
                     SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                     SelectionMode="Single" PreviewKeyDown="OnAssetListPreviewKeyDown"
                     Background="{StaticResource WindowBackground}"
                     BorderThickness="0" ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel ItemWidth="190" ItemHeight="260" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardRoot" CornerRadius="7" Padding="7" Margin="2"
                                BorderThickness="2"
                                Loaded="OnAssetCardLoaded" Unloaded="OnAssetCardUnloaded"
                                MouseEnter="OnAssetCardMouseEnter"
                                MouseLeave="OnAssetCardMouseLeave"
                                MouseLeftButtonDown="OnAssetCardDoubleClick"
                                PreviewMouseRightButtonDown="OnAssetCardRightButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource CardBackground}" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Background" Value="#34485F" />
                                            <Setter Property="BorderBrush" Value="#73B7FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="#D7E9FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInComparison}" Value="True">
                                            <Setter Property="BorderBrush" Value="#65C98D" />
                                            <Setter Property="BorderThickness" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open preview" Command="{Binding OpenPreviewCommand}" />
                                    <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="Show content inventory" Command="{Binding ShowContentInventoryCommand}" />
                                    <MenuItem Header="Add to comparison" Command="{Binding AddToComparisonCommand}" />
                                    <MenuItem Header="Create UE Import Package" Command="{Binding CreateUnrealImportPackageCommand}" />
                                    <Separator />
                                    <MenuItem Header="Copy asset ID" Command="{Binding CopyAssetIdCommand}" />
                                    <MenuItem Header="Copy folder path" Command="{Binding CopyFolderPathCommand}" />
                                    <MenuItem Header="Copy JSON path" Command="{Binding CopyJsonPathCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#15181D"
                                        CornerRadius="5" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="No preview" Foreground="#66707D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="3,7,3,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding TypeAndCategory}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TypeAndCategory}" />
                                    <TextBlock Text="{Binding CompactDetails}" FontSize="11"
                                               Foreground="{StaticResource Accent}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CompactDetails}" />
                                    <ItemsControl ItemsSource="{Binding Badges}" Margin="0,3,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Background="#405064" CornerRadius="3" Padding="4,1" Margin="0,0,3,2">
                                                <TextBlock Text="{Binding}" FontSize="9" Foreground="White" />
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Background="{Binding UnrealReadinessBrush}" CornerRadius="3" Padding="4,1" Margin="0,2,0,2"
                                            HorizontalAlignment="Left" ToolTip="{Binding UnrealReadinessTooltip}">
                                        <TextBlock Text="{Binding UnrealReadinessBadge}" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding ContentWarning}" FontSize="10" FontWeight="Bold" Foreground="#FFB3A7"
                                               Visibility="{Binding HasContentWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <Popup IsOpen="{Binding IsHoverOpen, Mode=OneWay}"
                                       PlacementTarget="{Binding ElementName=CardRoot}"
                                       Placement="MousePoint" HorizontalOffset="12" VerticalOffset="12"
                                       AllowsTransparency="True" StaysOpen="True"
                                       Focusable="False" PopupAnimation="Fade">
                                    <Border Background="#F3222730" BorderBrush="#687384"
                                            BorderThickness="1" CornerRadius="7"
                                            Padding="14" MaxWidth="470" MaxHeight="520">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                           FontSize="15" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding IdDisplay}" Foreground="#B9C1CC"
                                                           Margin="0,1,0,8" />
                                                <TextBlock Text="{Binding TypeAndCategory}"
                                                           Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding CategoriesDisplay, StringFormat=Categories: {0}}"
                                                           Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ResolutionDisplay, StringFormat=Resolution: {0}}"
                                                           Foreground="White" Visibility="{Binding HasResolution, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding PhysicalSizeDisplay, StringFormat=Physical size: {0}}"
                                                           Foreground="White" Visibility="{Binding HasPhysicalSize, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding TexelDensityDisplay, StringFormat=Texel density: {0}}"
                                                           Foreground="White" Visibility="{Binding HasTexelDensity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding BiomeDisplay, StringFormat=Biome: {0}}"
                                                           Foreground="White" Margin="0,7,0,0"
                                                           Visibility="{Binding HasBiome, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding RegionDisplay, StringFormat=Region: {0}}"
                                                           Foreground="White" Visibility="{Binding HasRegion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding DescriptiveTagsDisplay, StringFormat=Tags: {0}}"
                                                           Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0"
                                                           Visibility="{Binding HasDescriptiveTags, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding StateDisplay, StringFormat=State: {0}}"
                                                           Foreground="White" TextWrapping="Wrap"
                                                           Visibility="{Binding HasState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding ColorsDisplay, StringFormat=Colors: {0}}"
                                                           Foreground="White" TextWrapping="Wrap"
                                                           Visibility="{Binding HasColors, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding IndustriesDisplay, StringFormat=Industries: {0}}"
                                                           Foreground="White" TextWrapping="Wrap"
                                                           Visibility="{Binding HasIndustries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="Content" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,2" />
                                                <TextBlock Text="{Binding ContentVariantsDisplay}" Foreground="White" />
                                                <TextBlock Text="{Binding ContentLodsDisplay}" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ContentMeshesDisplay}" Foreground="White" />
                                                <TextBlock Text="{Binding ContentSetsDisplay}" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ContentMapsDisplay}" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ContentStatusDisplay}" Foreground="{StaticResource Accent}" />
                                                <TextBlock Text="{Binding ContentIssuesDisplay}" Foreground="#FFB3A7" />
                                                <TextBlock Text="{Binding UnrealReadinessStatusDisplay}" Foreground="{StaticResource Accent}" ToolTip="{Binding UnrealReadinessTooltip}" />
                                                <TextBlock Text="{Binding UnrealReadinessCountsDisplay}" Foreground="#FFCF88" TextWrapping="Wrap" />
                                                <Button Content="Show content inventory" Command="{Binding ShowContentInventoryCommand}"
                                                        HorizontalAlignment="Left" Padding="8,3" Margin="0,5,0,0" />
                                                <TextBlock Text="Folder" FontWeight="SemiBold" Foreground="White"
                                                           Margin="0,8,0,1" />
                                                <TextBlock Text="{Binding Asset.AssetFolderPath}" Foreground="#B9C1CC"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}"
                BorderBrush="#343B46" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding IndexedAssetCount, StringFormat=Indexed: {0:N0}}"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock DockPanel.Dock="Left" Margin="18,0,0,0"
                           Text="{Binding VisibleAssetCount, StringFormat=Visible: {0:N0}}"
                           Foreground="{StaticResource TextSecondary}" />
                <ProgressBar DockPanel.Dock="Right" Width="150" Height="8" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </DockPanel>
        </Border>

        <Grid Grid.RowSpan="3" Panel.ZIndex="20"
              Visibility="{Binding Preview.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Background="#D9000000" BorderThickness="0" Command="{Binding ClosePreviewCommand}" />
            <Border Background="#F31B1F25" BorderBrush="#657080" BorderThickness="1"
                    CornerRadius="10" Padding="16" Margin="70">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Close" Padding="14,6"
                                Command="{Binding ClosePreviewCommand}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Preview.Asset.Name}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding Preview.Asset.Id, StringFormat=ID: {0}}"
                                       Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#0E1014" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="Preview unavailable" Foreground="#66707D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                            <Image Source="{Binding Preview.Image}" Stretch="Uniform" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
