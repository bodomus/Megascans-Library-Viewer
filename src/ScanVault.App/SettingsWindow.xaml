<Window x:Class="ScanVault.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanVault Settings" Width="680" Height="330"
        MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Megascans library root"
                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Settings.LibraryRoot, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="9,6" />
            <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClick"
                    Padding="14,6" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Settings.ValidationError}"
                   Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,7,0,0" />

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="Changing the path does not rebuild the index automatically."
                       Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="Save the setting, then explicitly run Rescan."
                       Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                       Foreground="{StaticResource Accent}" Margin="0,14,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Rescan library"
                    Command="{Binding RescanCommand}" Padding="16,7" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left" Content="Cancel scan"
                    Command="{Binding CancelScanCommand}" Padding="16,7" />
            <Button DockPanel.Dock="Right" Content="Close" Click="OnCloseClick"
                    Padding="16,7" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save"
                    Command="{Binding SaveSettingsCommand}" Padding="16,7" />
        </DockPanel>
    </Grid>
</Window>
