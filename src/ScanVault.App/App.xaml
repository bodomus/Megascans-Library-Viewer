<Application x:Class="ScanVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="WindowBackground" Color="#171A1F" />
        <SolidColorBrush x:Key="PanelBackground" Color="#20242B" />
        <SolidColorBrush x:Key="CardBackground" Color="#292E37" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F3F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AEB6C2" />
        <SolidColorBrush x:Key="TextCheckBox" Color="#AEB6C2" />
        <SolidColorBrush x:Key="TextDarkPrimary" Color="#2F343A" />
        <SolidColorBrush x:Key="TextDarkSecondary" Color="#555D66" />
        <SolidColorBrush x:Key="Accent" Color="#65C98D" />
    </Application.Resources>
</Application>
