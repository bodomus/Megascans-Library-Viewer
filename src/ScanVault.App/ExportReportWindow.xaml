<Window x:Class="ScanVault.App.ExportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Report" Width="680" Height="700" MinWidth="600" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Report profile" FontWeight="SemiBold" />
                        <ComboBox Margin="0,5,0,0" ItemsSource="{Binding Profiles}" DisplayMemberPath="Label"
                                  SelectedValuePath="Profile" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Scope" FontWeight="SemiBold" />
                        <ComboBox Margin="0,5,0,0" ItemsSource="{Binding Scopes}" DisplayMemberPath="Label"
                                  SelectedValuePath="Scope" SelectedValue="{Binding SelectedScope, Mode=TwoWay}"
                                  IsEnabled="{Binding IsScopeEnabled}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Format" FontWeight="SemiBold" />
                        <ComboBox Margin="0,5,0,0" ItemsSource="{Binding Formats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Format" SelectedValue="{Binding SelectedFormat, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsScanChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Completed scan run" FontWeight="SemiBold" />
                    <ComboBox Margin="0,5,0,0" ItemsSource="{Binding ScanRuns}" SelectedItem="{Binding SelectedScanRun, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StartedAtUtc}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="Include unchanged scan items" IsChecked="{Binding IncludeUnchangedScanItems}"
                              Margin="0,8,0,0" Foreground="{StaticResource TextCheckBox}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsSmartCollection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Smart collection" FontWeight="SemiBold" />
                    <ComboBox Margin="0,5,0,0" ItemsSource="{Binding SmartCollections}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSmartCollection, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsCompleteness, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Completeness statuses" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox Content="Complete" IsChecked="{Binding CompleteSelected}" Margin="0,0,12,6" Foreground="{StaticResource TextCheckBox}" />
                        <CheckBox Content="Usable" IsChecked="{Binding UsableSelected}" Margin="0,0,12,6" Foreground="{StaticResource TextCheckBox}" />
                        <CheckBox Content="Partial" IsChecked="{Binding PartialSelected}" Margin="0,0,12,6" Foreground="{StaticResource TextCheckBox}" />
                        <CheckBox Content="Missing critical" IsChecked="{Binding MissingCriticalSelected}" Margin="0,0,12,6" Foreground="{StaticResource TextCheckBox}" />
                        <CheckBox Content="Ambiguous" IsChecked="{Binding AmbiguousSelected}" Margin="0,0,12,6" Foreground="{StaticResource TextCheckBox}" />
                        <CheckBox Content="Unknown" IsChecked="{Binding UnknownSelected}" Margin="0,0,12,6" Foreground="{StaticResource TextCheckBox}" />
                    </WrapPanel>
                </StackPanel>

                <TextBlock Text="Destination file" FontWeight="SemiBold" Margin="0,16,0,0" />
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" />
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseClick" Padding="12,5" Margin="8,0,0,0" />
                </Grid>

                <WrapPanel Margin="0,14,0,0">
                    <CheckBox Content="Include absolute paths" IsChecked="{Binding IncludeAbsolutePaths}" Margin="0,0,16,8" Foreground="{StaticResource TextCheckBox}" />
                    <CheckBox Content="Include metadata" IsChecked="{Binding IncludeMetadata}" Margin="0,0,16,8" Foreground="{StaticResource TextCheckBox}" />
                    <CheckBox Content="Pretty JSON" IsChecked="{Binding PrettyJson}" Margin="0,0,16,8"
                              Foreground="{StaticResource TextCheckBox}"
                              Visibility="{Binding IsJson, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>

                <Border Margin="0,12,0,0" Padding="12" BorderBrush="#343B46" BorderThickness="1" Background="{StaticResource PanelBackground}">
                    <StackPanel>
                        <TextBlock Text="Estimate" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}">
                            <Run Text="Assets: " /><Run Text="{Binding EstimatedAssetCount, Mode=OneWay, StringFormat=N0}" />
                            <Run Text="    Estimated rows: " /><Run Text="{Binding EstimatedRowCount, Mode=OneWay, StringFormat=N0}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="10" Background="{StaticResource PanelBackground}">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}">
                    <Run Text="Processed assets: " /><Run Text="{Binding ProcessedAssets, Mode=OneWay, StringFormat=N0}" />
                    <Run Text="    Written rows: " /><Run Text="{Binding WrittenRows, Mode=OneWay, StringFormat=N0}" />
                    <Run Text="    Elapsed: " /><Run Text="{Binding Elapsed, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Export" Click="OnExportClick" IsEnabled="{Binding CanExport}" Width="92" Padding="12,6" />
            <Button DockPanel.Dock="Right" Content="Cancel export" Click="OnCancelExportClick" IsEnabled="{Binding CanCancel}" Width="110" Padding="12,6" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Width="82" Padding="12,6" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
