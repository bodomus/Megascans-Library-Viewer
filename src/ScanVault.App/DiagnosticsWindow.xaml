<Window x:Class="ScanVault.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="780" Height="700" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="ScanVault" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Megascans Library Viewer — About / Diagnostics"
                       Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBackground}"
                CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <TextBlock Text="This report contains application, runtime, index, and scan state only. It does not collect secrets or unrelated environment data."
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Fields}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,1" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{StaticResource PanelBackground}" Margin="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                   FontWeight="SemiBold" Padding="10,7"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                   Padding="10,7" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="Copy diagnostics"
                    Command="{Binding CopyDiagnosticsCommand}" Padding="16,7" />
            <Button DockPanel.Dock="Right" Content="Close"
                    Click="OnCloseClick" Padding="16,7" />
            <TextBlock Text="{Binding CopyStatus}" Margin="12,0"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource Accent}" />
        </DockPanel>
    </Grid>
</Window>
